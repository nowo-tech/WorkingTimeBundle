{#
  Holiday calendars and work centres (contract section 11.1, holidays_manage; works without the register or leave).
  Variables: page (ListPage of calendars), calendar_form, centre_form (FormView), centres (list of {name, default,
  href, calendars}), municipalities (null without festivos.io, else {loaded, form, search}).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}

{% block nowo_ui_list_after %}
    {%- set _b = page.bundle -%}
    {%- set _d = 'NowoWorkingTimeBundle' -%}
    {{ include('@NowoWorkingTime/holidays/_form.html.twig', {form: calendar_form, title: 'holiday.calendar.add', submit: 'holiday.calendar.save', action: null, testid: 'wt-holiday-calendar-form'}) }}
    <section class="{{ nowo_ui_class('card', _b) }}" data-testid="wt-holiday-centres">
        <div class="{{ nowo_ui_class('card_body', _b) }}">
            <h2 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'holiday.centre.title'|trans({}, _d) }}</h2>
            <p>{{ 'holiday.centre.intro'|trans({}, _d) }}</p>
            {% if centres is empty %}
                <p data-testid="wt-holiday-centres-empty">{{ 'holiday.centre.empty'|trans({}, _d) }}</p>
            {% else %}
                <ul>
                    {% for centre in centres %}
                        <li><a href="{{ centre.href }}" data-testid="wt-holiday-centre">{{ centre.name }}</a> · {{ 'holiday.centre.calendars'|trans({'%count%': centre.calendars}, _d) }}{% if centre.default %} · <strong>{{ 'holiday.centre.default'|trans({}, _d) }}</strong>{% endif %}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </section>
    {{ include('@NowoWorkingTime/holidays/_form.html.twig', {form: centre_form, title: 'holiday.centre.add', submit: 'holiday.centre.save', action: null, testid: 'wt-holiday-centre-form'}) }}
    {% if municipalities %}
        <section class="{{ nowo_ui_class('card', _b) }}" data-testid="wt-municipalities">
            <div class="{{ nowo_ui_class('card_body', _b) }}">
                <h2 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'holiday.municipalities.title'|trans({}, _d) }}</h2>
                <p>{{ (municipalities.loaded ? 'holiday.municipalities.loaded' : 'holiday.municipalities.not_loaded')|trans({'%url%': municipalities.search}, _d) }}</p>
                <p><small>festivos.io — CC BY 4.0</small></p>
                {{ form_start(municipalities.form, {action: path('nowo_working_time_holiday_municipalities_refresh')}) }}
                {{ form_widget(municipalities.form) }}
                <button type="submit" class="{{ nowo_ui_class('btn_secondary', _b) }}">{{ 'holiday.municipalities.refresh'|trans({}, _d) }}</button>
                {{ form_end(municipalities.form) }}
            </div>
        </section>
    {% endif %}
{% endblock %}
