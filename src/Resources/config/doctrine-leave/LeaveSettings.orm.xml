<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\WorkingTimeBundle\Domain\Leave\Model\LeaveSettings" table="working_time_leave_settings">
        <id name="tenantId" column="tenant_id" type="string" length="128"><generator strategy="NONE"/></id>
        <field name="enabled" column="enabled" type="boolean"/>
        <field name="colleaguesSeeAbsences" column="colleagues_see_absences" type="boolean"/>
        <field name="medicalDocuments" column="medical_documents" type="boolean"/>
        <field name="attachmentRetentionMonths" column="attachment_retention_months" type="smallint"/>
        <field name="overtimeRatio" column="overtime_ratio" type="smallint"/>
        <field name="planningDeadline" column="planning_deadline" type="string" length="5" nullable="true"/>
        <field name="rounding" column="rounding" type="string" length="8" enum-type="Nowo\WorkingTimeBundle\Domain\Leave\Enum\RoundingMode"/>
        <field name="protectedCarryMonths" column="protected_carry_months" type="smallint"/>
        <field name="approvalChains" column="approval_chains" type="json"/>
        <field name="minStaffing" column="min_staffing" type="json"/>
        <field name="version" column="version" type="integer" version="true"/>
        <field name="updatedById" column="updated_by_id" type="string" length="128" nullable="true"/>
        <field name="updatedAt" column="updated_at" type="nowo_wt_utc_datetime"/>
    </entity>
</doctrine-mapping>
