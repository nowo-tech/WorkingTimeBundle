<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\WorkingTimeBundle\Domain\Holiday\Model\WorkCentre" table="holiday_work_centre">
        <indexes>
            <index name="wt_holiday_centre_tenant" columns="tenant_id"/>
        </indexes>
        <id name="id" type="string" length="36"><generator strategy="NONE"/></id>
        <field name="tenantId" column="tenant_id" type="string" length="128"/>
        <field name="name" column="name" type="string" length="80"/>
        <field name="calendarIds" column="calendar_ids" type="json"/>
        <field name="isDefault" column="is_default" type="boolean"/>
    </entity>
</doctrine-mapping>
