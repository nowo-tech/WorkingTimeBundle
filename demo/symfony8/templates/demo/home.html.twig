{% extends 'base.html.twig' %}

{% block title %}Overview{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Working Time Bundle',
        intro: 'A working-hours register, public holidays and leave in one bundle with three parts that can be switched on separately.',
    }) }}
{% endblock %}

{% block body %}
    <section class="nowo-ui-card" data-testid="demo-status">
        <div class="nowo-ui-card__body">
            <p>
                <span class="nowo-ui-badge nowo-ui-badge--info">S0</span>
                Scaffold only: the pages of each part arrive with their slice.
            </p>
            <table class="nowo-ui-data-table">
                <tbody>
                    <tr><th scope="row">Bundle</th><td><code class="nowo-ui-code">Nowo\WorkingTimeBundle\NowoWorkingTimeBundle</code> registered</td></tr>
                    {% for name, enabled in parts %}
                        <tr><th scope="row">{{ name }}</th><td>{{ enabled ? 'enabled' : 'disabled' }}</td></tr>
                    {% endfor %}
                    <tr><th scope="row">Database</th><td>{{ database is null ? 'not reachable' : 'MySQL ' ~ database }}</td></tr>
                    <tr><th scope="row">FrankenPHP</th><td>{{ worker ? 'worker mode (kernel kept alive, not reset)' : 'classic mode' }}</td></tr>
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
