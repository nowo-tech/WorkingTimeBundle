{% extends 'base.html.twig' %}

{#
  The stand-alone holiday component (contract section 1): an agenda that only reads HolidayCalendarReaderInterface
  (the tenant's default work centre, else every calendar), with no register or leave involved.
#}
{% block title %}Agenda{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Public holidays ' ~ year,
        intro: 'Read through HolidayCalendarReaderInterface only, as an agenda or a CRM would. Ada manages the calendars on the Holidays page.',
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Holidays', kind: 'table', testid: 'demo-agenda', rows: rows, empty: rows is empty, state_message: 'No holiday yet this year.'} %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead><tr><th scope="col">Date</th><th scope="col">Holiday</th><th scope="col">Scope</th></tr></thead>
                <tbody>
                    {% for row in rows %}
                        <tr data-testid="demo-agenda-row"><th scope="row" class="nowo-ui-cell--date"><time datetime="{{ row.date }}">{{ row.date }}</time></th><td>{{ row.name }}</td><td>{{ row.scope }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}
{% endblock %}
